{
  "manifest_version": 3,
  "name": "VanishCam",
  "short_name": "VanishCam",
  "version": "0.1.0",
  "description": "Desaparece de tu camara en Google Meet con un gesto: Goku, Naruto o Particulas.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VanishCam: mostrar u ocultar el panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "lib/vision_wasm_internal.js",
        "src/gestures.js",
        "src/effects.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "models/*", "assets/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
